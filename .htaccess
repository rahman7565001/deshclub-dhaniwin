# =============================================================
# Deshclub Universal Apache / LiteSpeed Configuration
# Compatible with cPanel, Hostinger, Namecheap, Plesk, etc.
# =============================================================

Options -Indexes
DirectoryIndex index.php index.html
RewriteEngine On

# -------------------------------------------------------------
# Pass Bearer Authorization Header to PHP
# -------------------------------------------------------------
SetEnvIf Authorization "(.*)" HTTP_AUTHORIZATION=$1
RewriteCond %{HTTP:Authorization} .
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

# -------------------------------------------------------------
# Force HTTPS (Supports Cloudflare & Reverse Proxies)
# -------------------------------------------------------------
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
RewriteCond %{HTTP_HOST} !^localhost [NC]
RewriteCond %{HTTP_HOST} !^127\.0\.0\.1 [NC]
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L,NE]

# -------------------------------------------------------------
# Universal MIME Types (Audio, Video, Images, Fonts, PWA)
# -------------------------------------------------------------
<IfModule mime_module>
  AddType application/javascript .js .mjs
  AddType text/css .css
  AddType application/json .json
  AddType application/manifest+json .webmanifest
  AddType font/woff2 .woff2
  AddType font/woff .woff
  AddType font/ttf .ttf
  AddType font/otf .otf
  AddType application/vnd.ms-fontobject .eot
  AddType image/svg+xml .svg
  AddType image/webp .webp
  AddType image/avif .avif
  AddType video/mp4 .mp4
  AddType video/webm .webm
  AddType audio/mpeg .mp3
  AddType audio/wav .wav
  AddType audio/ogg .ogg
  AddType application/wasm .wasm
</IfModule>

# -------------------------------------------------------------
# Universal CORS Headers for Static Assets & Media
# -------------------------------------------------------------
<IfModule mod_headers.c>
  <FilesMatch "\.(woff2|woff|ttf|otf|eot|svg|webp|avif|png|jpg|jpeg|gif|ico|mp4|webm|mp3|wav|ogg|json)$">
    Header set Access-Control-Allow-Origin "*"
    Header set Access-Control-Allow-Methods "GET, HEAD, OPTIONS"
    Header set Access-Control-Allow-Headers "*"
  </FilesMatch>

  <FilesMatch "^(index\.(html|php)|version\.json|pwa-sw\.js|ar-sw\.js)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>
</IfModule>

# -------------------------------------------------------------
# Existing real files/folders direct load
# -------------------------------------------------------------
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# -------------------------------------------------------------
# Static Asset Fallbacks (Images, Media, Banners)
# -------------------------------------------------------------
# Fallback 1: 0/
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{DOCUMENT_ROOT}/0%{REQUEST_URI} -f
RewriteRule ^(.*)$ 0/$1 [L]

# Fallback 2: 6006/
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{DOCUMENT_ROOT}/6006%{REQUEST_URI} -f
RewriteRule ^(.*)$ 6006/$1 [L]

# Fallback 3: img/
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{DOCUMENT_ROOT}/img%{REQUEST_URI} -f
RewriteRule ^(.*)$ img/$1 [L]

# Fallback 4: pro-img.arsaaspub.com/
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{DOCUMENT_ROOT}/pro-img.arsaaspub.com%{REQUEST_URI} -f
RewriteRule ^(.*)$ pro-img.arsaaspub.com/$1 [L]

# Fallback 5: assets/
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{DOCUMENT_ROOT}/assets%{REQUEST_URI} -f
RewriteRule ^(.*)$ assets/$1 [L]

# Fallback 6: images/
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{DOCUMENT_ROOT}/images%{REQUEST_URI} -f
RewriteRule ^(.*)$ images/$1 [L]

# -------------------------------------------------------------
# Dynamic Lottery Draw Routes
# -------------------------------------------------------------
RewriteRule ^webapi/(kv|v)/issue/([^/]+)$ api/_draw_router.php?gameCode=$2 [QSA,L]
RewriteRule ^(WinGo|K3|D5|MotoRace|TrxWinGo)/(.+\.json)$ api/_draw_router.php?path=$1/$2 [QSA,L]

# -------------------------------------------------------------
# Config Fallbacks
# -------------------------------------------------------------
RewriteRule ^webapi/v/config\.js$ webapi/kv/config.js [QSA,L]
RewriteRule ^webapi/v/firebaseConfig\.js$ webapi/kv/firebaseConfig.js [QSA,L]

# -------------------------------------------------------------
# Cashier Payment Gateway
# -------------------------------------------------------------
RewriteCond %{REQUEST_URI} ^/pay [NC]
RewriteRule ^pay(/.*)?$ pay/index.php [QSA,L]

# -------------------------------------------------------------
# Core API Routes
# -------------------------------------------------------------
RewriteCond %{REQUEST_URI} ^/api/ [NC]
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.+)$ $1.php [L]

RewriteCond %{REQUEST_URI} ^/api/ [NC]
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+)$ $1.html [L]

RewriteRule ^(?:webapi/|api/)?(Recharge|Withdraw|Activity|User|Home|Game|Lottery|ThirdGame|VipLevel|AgentRebate|WorkOrder)(/.*)?$ api/_router.php?path=$1$2 [QSA,L]

RewriteCond %{REQUEST_URI} ^/webapi/(?!kv/|v/) [NC]
RewriteRule ^webapi/(.*)$ api/_router.php?path=$1 [QSA,L]

RewriteCond %{REQUEST_URI} ^/api/ [NC]
RewriteCond %{REQUEST_URI} !^/api/(_router|_draw_router|_bootstrap|config)\.php$ [NC]
RewriteRule ^api/(.*)$ api/_router.php?path=$1 [QSA,L]

# -------------------------------------------------------------
# Universal Fallback (SPA routing & asset fallback via index.php)
# -------------------------------------------------------------
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [L]

ErrorDocument 404 /index.php
